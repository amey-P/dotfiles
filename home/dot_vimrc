" Minimal, plugin-free vim. Neovim is the main editor.
set nocompatible
syntax enable
filetype plugin indent on

set hidden
set number relativenumber
set incsearch hlsearch ignorecase smartcase
set autoindent
set scrolloff=5
set wildmenu
set path+=**
set laststatus=2
set statusline=%f\ %m%r%=%l:%c
set backspace=indent,eol,start
set showbreak=↳
set mouse=
set t_Co=256

if executable('rg')
	set grepprg=rg\ --vimgrep
endif

colorscheme iceberg

" Netrw
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_winsize = 25

" Mappings
nnoremap Y y$
nnoremap n nzzzv
nnoremap N Nzzzv
nnoremap <Leader>e :find<Space>
nnoremap <Leader>b :ls<CR>:b<Space>
nnoremap <Leader>f :grep<Space>
nnoremap <F4> :Lexplore<CR>
